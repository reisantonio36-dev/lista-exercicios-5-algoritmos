# Exercício 3 - Pedido de lanchonete
cardapio = {
    100: {"nome": "Cachorro Quente", "preco": 1.20},
    101: {"nome": "Bauru Simples", "preco": 1.30},
    102: {"nome": "Bauru com ovo", "preco": 1.50},
    103: {"nome": "Hambúrguer", "preco": 1.20},
    104: {"nome": "Cheeseburguer", "preco": 1.30},
    105: {"nome": "Refrigerante", "preco": 1.00}
}

total_geral = 0.0

print("=== CARDÁPIO ===")
for cod, item in cardapio.items():
    print(f"Código: {cod} | {item['nome']} - R$ {item['preco']:.2f}")
print("Digite 0 para encerrar o pedido.\n")

while True:
    codigo = int(input("Digite o código do item: "))
    if codigo == 0:
        break
    if codigo in cardapio:
        qtd = int(input(f"Quantidade de {cardapio[codigo]['nome']}: "))
        valor_item = cardapio[codigo]["preco"] * qtd
        total_geral += valor_item
        print(f"Valor deste item: R$ {valor_item:.2f}\n")
    else:
        print("Código inválido! Tente novamente.\n")

print(f"\nTotal geral do pedido: R$ {total_geral:.2f}")

