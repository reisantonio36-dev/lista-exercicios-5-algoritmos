# Exercício 7 - Notas de ginástica
while True:
    nome = input("\nNome do ginasta (vazio para encerrar): ").strip()
    if not nome:
        break
    notas = []
    for i in range(7):
        nota = float(input(f"Nota do {i+1}º jurado: "))
        notas.append(nota)
    
    melhor = max(notas)
    pior = min(notas)
    notas_restantes = [n for n in notas if n != melhor and n != pior]
    media = sum(notas_restantes) / len(notas_restantes)

    print(f"\nAtleta: {nome}")
    print(f"Melhor nota: {melhor}")
    print(f"Pior nota: {pior}")
    print(f"Média final: {media:.2f}")

