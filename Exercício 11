# Exercício 11 - 
n = int(input("Digite a quantidade de termos: "))
soma = 0.0

print("S = ", end="")
for i in range(1, n+1):
    denominador = 2 * i - 1
    termo = i / denominador
    soma += termo
    if i > 1:
        print(" + ", end="")
    print(f"{i}/{denominador}", end="")

print(f"\nSoma total: {soma:.4f}")

