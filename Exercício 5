# Exercício 5 - Correção de provas
gabarito = ["A", "B", "C", "D", "E", "E", "D", "C", "B", "A"]
notas = []

while True:
    acertos = 0
    print("\nRespostas do aluno:")
    for i in range(10):
        resp = input(f"Questão {i+1}: ").upper()
        if resp == gabarito[i]:
            acertos += 1
    notas.append(acertos)
    print(f"Nota: {acertos} pontos")

    continuar = input("Outro aluno? (S/N): ").upper()
    if continuar != "S":
        break

if notas:
    print("\n=== RESUMO DA TURMA ===")
    print(f"Maior acerto: {max(notas)}")
    print(f"Menor acerto: {min(notas)}")
    print(f"Total de alunos: {len(notas)}")
    print(f"Média da turma: {sum(notas)/len(notas):.2f}")

